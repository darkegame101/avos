# AVOS Environment Configuration (Template)
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Master Authentication (Required for Control Plane)
# Owner token for administrative and approval actions.
# Must be a cryptographically strong random token (e.g. openssl rand -hex 32)
AVOS_OWNER_TOKEN=change-this-to-a-secure-random-token-min-32-chars

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://avos_user:avos_password@localhost:5432/avos_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Budget & Cost Limits (USD)
AVOS_MONTHLY_BUDGET_CAP=50.00
AVOS_DEFAULT_EXPERIMENT_BUDGET=20.00

# Worker Plane Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000

# Emergency Stop (Persistence flag file if running local without DB)
EMERGENCY_STOP_FILE=./data/emergency_stop.json

# Automaton Sandbox Configuration
AUTOMATON_ENABLED=false
AUTOMATON_SANDBOX_PATH=./sandbox/automaton
AUTOMATON_ALLOW_EXTERNAL_ACTIONS=false
